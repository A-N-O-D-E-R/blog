---
import BaseLayout from './BaseLayout.astro';
import { formatDate, readingTime } from '@/lib/utils';
import TOC from '@/components/TOC.astro';
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, date, tags, image } = post.data;
const { Content, headings } = await render(post);
const readTime = readingTime(post.body);
---

<BaseLayout title={title} description={description} image={image}>
  <article class="prose prose-zinc dark:prose-invert max-w-3xl mx-auto">
    <header class="mb-8">
      <h1 class="text-4xl font-bold mb-4">{title}</h1>
      <div class="text-sm text-zinc-600 dark:text-zinc-400">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        · {readTime} min read
      </div>
      {tags.length > 0 && (
        <div class="flex gap-2 mt-4">
          {tags.map(tag => (
            <a
              href={`/tags/${tag}`}
              class="px-2 py-1 text-xs rounded-full bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 no-underline"
            >
              {tag}
            </a>
          ))}
        </div>
      )}
    </header>
    {headings.length > 0 && <TOC headings={headings} />}
    <Content />
  </article>
</BaseLayout>
