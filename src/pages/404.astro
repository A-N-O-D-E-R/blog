---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Not Found" description="Page not found">
  <div class="text-center py-16">
    <h1 class="text-6xl font-bold mb-4">404</h1>
    <p class="text-xl text-zinc-600 dark:text-zinc-400 mb-8">Page not found</p>
    <a
      href={import.meta.env.BASE_URL}
      class="px-4 py-2 rounded-lg border border-zinc-200 dark:border-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition inline-block"
    >
      Go Home
    </a>
  </div>
</BaseLayout>
