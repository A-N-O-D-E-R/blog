---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogList from '@/components/BlogList.tsx';
import ExternalFeedList from '@/components/ExternalFeedList.tsx';
import { getPosts } from '@/lib/utils';
import { CATEGORIZED_FEEDS, CATEGORY_COLORS } from '@/lib/external-feeds';
import { fetchAllExternalFeeds } from '@/lib/rss';

const posts = await getPosts();

const categoryPosts = await Promise.all(
  Object.entries(CATEGORIZED_FEEDS).map(async ([category, feeds]) => {
    const externalFeeds = Object.fromEntries(
      Object.entries(feeds).filter(([_, url]) => url.startsWith('http'))
    );
    const posts = await fetchAllExternalFeeds(externalFeeds);
    return { category, posts };
  })
);
---

<BaseLayout title="Blog" description="All blog posts">
  <h1 class="text-4xl font-bold mb-8">Blog</h1>

  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6">My Posts</h2>
    <BlogList client:load initialPosts={posts} />
  </section>

  {categoryPosts.map(({ category, posts }) => posts.length > 0 && (
    <section class="mb-12">
      <h2 class={`text-2xl font-bold mb-6 ${CATEGORY_COLORS[category] || ''}`}>{category}</h2>
      <ExternalFeedList client:load initialPosts={posts} />
    </section>
  ))}
</BaseLayout>
