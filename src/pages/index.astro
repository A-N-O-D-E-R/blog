---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogCard from '@/components/BlogCard.astro';
import { getPosts } from '@/lib/utils';
import { CATEGORIZED_FEEDS } from '@/lib/external-feeds';

const posts = await getPosts();
const latestPosts = posts.slice(0, 6);
const allExternalFeeds = Object.entries(CATEGORIZED_FEEDS).flatMap(([_, feeds]) =>
  Object.entries(feeds)
);
---

<BaseLayout title="Home" description="Welcome to my blog">
  <section class="mb-12">
    <h1 class="text-4xl font-bold mb-4">Hi, I'm A-N-O-D-E-R</h1>
    <p class="text-xl text-zinc-600 dark:text-zinc-400">
      I write about web development, design, and tech.
    </p>
  </section>

  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6">anoder</h2>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {latestPosts.map(post => <BlogCard post={post} />)}
    </div>
    <div class="mt-8">
      <a
        href="/blog"
        class="px-4 py-2 rounded-lg border border-zinc-200 dark:border-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition inline-block"
      >
        View All Posts →
      </a>
    </div>
  </section>

  <section>
    <h2 class="text-2xl font-bold mb-6">External Feeds ({allExternalFeeds.length} feeds)</h2>
    <div class="text-center">
      <a
        href="/blog"
        class="px-4 py-2 rounded-lg border border-zinc-200 dark:border-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition inline-block"
      >
        Browse All Feeds →
      </a>
    </div>
  </section>
</BaseLayout>
